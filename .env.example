# Token OAuth de uma aplicação Mercado Livre autorizada. Apenas no servidor.
MELI_ACCESS_TOKEN=

# Amazon Creators API (Brasil), obtidos no Portal de Associados após aprovação.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG=

# Catálogo opcional de parceiro autorizado. O arquivo .sig contém HMAC-SHA256 hexadecimal do arquivo.
CATALOG_IMPORT_FILE=
CATALOG_IMPORT_KEY=
CATALOG_PARTNER_NAME=
CATALOG_ALLOWED_HOSTS=
SERPAPI_API_KEY=
SEARCHAPI_API_KEY=

# Redis compartilhado (Upstash via Vercel Marketplace). Sem essas variáveis, a busca externa é bloqueada.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# TTL dos resultados, em segundos (60–3600; padrão 900).
SEARCH_CACHE_TTL_SECONDS=900
# Créditos estimados por dia UTC e por pesquisa normalizada (padrões 20 e 6).
SEARCH_DAILY_CREDIT_BUDGET=20
SEARCH_CREDIT_LIMIT_PER_QUERY=6
